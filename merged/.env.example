# Copy this file to `.env.local` (not `.env`) and fill in real values for deployment.
# Never commit `.env.local` to Git — it is already in `.gitignore`.

# ------------------------------------------------------------------
# PUBLIC ORIGIN — required for absolute URLs in sitemap, canonical,
# Open Graph cards, and the siteUrl() helper.
# On Vercel the production URL is picked up automatically; set this
# explicitly only for custom domains or preview deployments.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------
# APPLICATION IDENTITY
NEXT_PUBLIC_APP_VERSION=1.3.0
NEXT_PUBLIC_BUILD_TIME=

# ------------------------------------------------------------------
# ANALYTICS & TRACKING (optional — leave empty to disable)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://public@sentry.example.com/1
# NEXT_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------
# VERCEL ENVIRONMENT
VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_URL=
VERCEL_ENV=development

# ------------------------------------------------------------------
# BUILD & RUNTIME
NODE_OPTIONS=--max-old-space-size=4096
PORT=3000
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------
# DEVELOPER BETA (see docs/BETA.md) — leave BOTH unset everywhere except the `beta` branch preview.
# Never set these for the Production environment. A production deploy refuses developer tools even if set.
# NEXT_PUBLIC_ENABLE_DEV_TOOLS=true   # build-time: builds the console + storage namespace into the bundle
# ENABLE_DEV_TOOLS=true               # server-only: lets /api/dev/status answer (otherwise 404)

# ==================================================================
# PHASE 2 — LIVE DISCOVERY (all OFF by default; nothing here is needed to play the game)
# Set these ONLY in Vercel *Preview/Staging* environment variables, never in git.
# ==================================================================
# Master switches (default false). The game works identically with every one of them off.
CREATIVE_LLM_ENABLED=false         # allow the server to ask a model about rare, eligible unknown combinations
CREATIVE_PUBLIC_ROLLOUT=false      # let anonymous players use it (keep false while only the owner is testing)
MODE_AI_ENABLED=false              # allow the owner-only mode-packet generator to call a model
ASSET_AI_ENABLED=false             # allow the asset worker to create 3D drafts
NEXT_PUBLIC_CREATIVE_UI=false      # show the "possible route is being reviewed" UI
NEXT_PUBLIC_ASSET_UI=false         # use owner-approved generated GLB models
NEXT_PUBLIC_MODE_PACKETS=false     # show owner-published mode flavour notes

# Spending guard. 0 = nothing can ever be spent. Keep it tiny for the first staging test.
CREATIVE_DAILY_USD_CAP=0
CREATIVE_RESERVE_USD=0.02          # held before each call, released/settled after
CREATIVE_PROVIDER_TIMEOUT_MS=12000
CREATIVE_GUEST_DAILY_ATTEMPTS=20
CREATIVE_ACTOR_SALT=               # long random string (server-only); required for any rollout

# Database (Neon/Postgres). Without it the whole feature reports "unavailable" and the game is untouched.
DATABASE_URL=
CREATIVE_AUTO_MIGRATE=false        # true only on a throw-away staging DB; production uses `npm run db:migrate`

# Model provider (get the CURRENT model id from the provider's console; do not guess)
ANTHROPIC_API_KEY=
CREATIVE_MODEL_ID=
CREATIVE_PRICE_IN_PER_MTOK=        # USD per million input tokens, from the provider's price page
CREATIVE_PRICE_OUT_PER_MTOK=       # USD per million output tokens (if empty, every call is booked at the reserve = worst case)
MODE_PROVIDER=                     # "fake" = free deterministic dry-run for staging; empty = real provider
MODE_AUTO_SERVE_FLAVOR=false       # true = flavour-only modes (civilization, decipher, escape-room) skip the human click

# Owner review (already used by Phase 1). Closed on production by design.
OWNER_REVIEW_TOKEN=                # long random string; sent as "Authorization: Bearer ..."

# 3D assets (optional)
ASSET_PROVIDER=                    # "meshy" for the real provider; empty = free mock
MESHY_API_KEY=
BLOB_READ_WRITE_TOKEN=
ASSET_PUBLIC_BASE_URL=
NEXT_PUBLIC_ASSET_HOSTS=           # comma separated hosts the browser may load approved GLB files from
ASSET_USD_PER_JOB=0.2
CRON_SECRET=                       # Vercel Cron sends it as a Bearer token to /api/internal/assets/tick

# ------------------------------------------------------------------
# RESOURCE VISUAL LAB (local development prototype, see docs/RESOURCE_VISUAL_LAB.md)
# Never set these on Vercel. The lab refuses to open on Vercel / production and only talks to a loopback Ollama.
# VISUAL_LAB=true
# ENABLE_DEV_TOOLS=true
# OLLAMA_URL=http://127.0.0.1:11434   # must be loopback
# OLLAMA_MODEL=qwen3:14b
# OLLAMA_TIMEOUT_MS=240000
# OLLAMA_CONCURRENCY=1
# OLLAMA_MAX_ATTEMPTS=3

# ------------------------------------------------------------------
# QUIZ STUDIO (Supabase) — see supabase/migrations and docs in the PR. Names only; set real values in Vercel / .env.local, never commit them.
NEXT_PUBLIC_SUPABASE_URL=          # https://<project-ref>.supabase.co  (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # public anon (legacy JWT) key ...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # ... or the modern sb_publishable_ key (either one works)
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY. Legacy service_role key ...
# SUPABASE_SECRET_KEY=             # ... or the modern sb_secret_ key (either one works). Never prefix with NEXT_PUBLIC_.
# CRON_SECRET (above) also protects /api/quiz/cron/cleanup, which vercel.json calls daily.
